page {
  background: var(--bg-page);
  min-height: 100%;
}

.analysis-page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.immersive-header {
  background: var(--grad-header);
  position: relative;
}

.status-bar-placeholder {
  height: calc(env(safe-area-inset-top, 20px) + 8px);
  min-height: 48px;
}

.custom-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 12rpx 32rpx;
  height: 88rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-strong);
  letter-spacing: 4rpx;
}

.header-curve {
  height: 32rpx;
  background: var(--bg-page);
  border-radius: 32rpx 32rpx 0 0;
}

.analysis-content {
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.mode-card {
  margin-bottom: 16rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow:
    0 12rpx 26rpx rgba(15, 23, 42, 0.07),
    0 0 0 1rpx rgba(226, 232, 240, 0.85);
  overflow: hidden;
}

.month-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow:
    0 10rpx 24rpx rgba(15, 23, 42, 0.05),
    0 0 0 1rpx rgba(226, 232, 240, 0.85);
}

.month-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.month-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A9BEB;
}

.td-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 14rpx 34rpx rgba(15, 23, 42, 0.08),
    0 0 0 1rpx rgba(226, 232, 240, 0.85);
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.score-card {
  padding: 30rpx 24rpx 26rpx;
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.score-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2A3D57;
}

.score-subtitle {
  font-size: 22rpx;
  color: #6B7280;
}

.score-badge-small {
  background: #F7FBFF;
  color: #5A9BEB;
  border-radius: 24rpx;
  padding: 8rpx 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.score-unit {
  font-size: 22rpx;
  opacity: 0.72;
}

.score-main-row {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.ring-wrap {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  flex: 0 0 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-container {
  position: relative;
}

.ring-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.score-circle-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #5A9BEB;
  line-height: 1;
}

.score-circle-caption {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7280;
}

.score-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.score-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.score-meta-row.muted {
  margin-top: 2rpx;
}

.score-meta-label {
  font-size: 24rpx;
  color: #6B7280;
}

.score-meta-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #2A3D57;
}

.score-meta-value-strong {
  font-size: 30rpx;
  font-weight: 700;
  color: #16A34A;
}

.score-meta-caption {
  font-size: 22rpx;
  color: #9CA3AF;
}

.score-stars {
  display: flex;
  justify-content: flex-end;
  max-width: 260rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 200rpx;
  text-align: center;
}

.stat-num {
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-num--success {
  color: #10B981;
}

.stat-num--warning {
  color: #F59E0B;
}

.stat-num--danger {
  color: #F43F5E;
}

.stat-num--info {
  color: #3B82F6;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

.stat-sub {
  font-size: 22rpx;
  color: #9CA3AF;
}

.chart-card {
  padding-bottom: 20rpx;
}

.chart-header {
  margin-bottom: 12rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2A3D57;
}

.chart-subtitle {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.chart-wrap {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  background-color: #FFFFFF;
  overflow: hidden;
  position: relative;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 8rpx 18rpx;
  color: #2A3D57;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-row {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #6B7280;
}

.detail-num {
  font-size: 40rpx;
  font-weight: 700;
}

.detail-item.success .detail-num {
  color: #10B981;
}

.detail-item.warning .detail-num {
  color: #F59E0B;
}

.detail-item.error .detail-num {
  color: #F43F5E;
}

.advice-card {
  margin-bottom: 14rpx;
}

.advice-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.advice-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.advice-text {
  flex: 1;
  min-width: 0;
}

.advice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A3D57;
}

.advice-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #6B7280;
}

.action-section {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
}

.gradient-btn,
.outline-btn {
  height: 94rpx;
  border-radius: 47rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.outline-btn {
  margin-top: 14rpx;
}

.gradient-btn {
  background: linear-gradient(135deg, #8FC2FF 0%, #72B1F7 50%, #9ED0FF 100%);
  box-shadow: 0 10rpx 24rpx rgba(110, 175, 248, 0.34);
}

.gradient-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.outline-btn {
  border: 2rpx solid #5A9BEB;
  background-color: #FFFFFF;
}

.outline-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A9BEB;
}

.footer-note {
  padding: 8rpx 4rpx 12rpx;
}

.footer-note text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #94A3B8;
  text-align: center;
}
