
/* pages/med-manage/index.wxss */
page {
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* ===== 頂部導航 ===== */
.immersive-header {
  background: var(--grad-header);
  position: relative;
}

.status-bar-placeholder {
  height: calc(env(safe-area-inset-top, 20px) + 8px);
  min-height: 48px;
}

.custom-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 12rpx 32rpx;
  height: 88rpx;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.header-curve {
  height: 32rpx;
  background: var(--bg-page);
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -2rpx; /* Fix gap */
}

.page-container {
  padding: 0 24rpx 180rpx;
  box-sizing: border-box;
}

/* 年份選擇 */
.year-picker-container {
  padding: 0 0 24rpx 8rpx;
}

.year-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #0052D9;
  font-size: 30rpx;
  font-weight: 600;
  background: #FFFFFF;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.08);
}

/* 時段區塊 */
.period-section {
  margin-bottom: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.period-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.period-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

/* 網格布局 */
.med-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

/* 藥格卡片 */
.med-slot {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 2rpx solid #E2E8F0;
  min-height: 240rpx;
  justify-content: center;
  position: relative;
  transition: all 0.2s;
}

.med-slot:active {
  transform: scale(0.98);
  background: #F1F5F9;
}

.med-slot--empty {
  border: 2rpx dashed #CBD5E1;
  background: #FFFFFF;
}

.med-slot-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  width: 100%;
}

.med-name-row {
    display: flex;
    align-items: center;
    gap: 6rpx;
    width: 100%;
    justify-content: center;
}

.med-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.med-dose-tag {
    background: #EFF6FF;
    color: #3B82F6;
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 8rpx;
    font-weight: 500;
}

/* 藥格內部信息展示 */
.med-info-block {
    display: flex;
    flex-direction: column;
    gap: 4rpx;
    width: 100%;
    margin-top: 4rpx;
    margin-bottom: 8rpx;
}

.info-row {
    display: flex;
    align-items: center;
    gap: 6rpx;
    font-size: 20rpx;
    color: #64748B;
    justify-content: center;
}

.stock-text {
    font-size: 18rpx;
    color: #94A3B8;
    margin-top: auto;
}

.refill-btn {
    margin-top: auto;
}

/* 添加按鈕樣式 */
.add-icon-circle {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8rpx;
}

.med-add-hint {
    font-size: 24rpx;
    color: #94A3B8;
    font-weight: 500;
}

/* ===== 編輯彈窗樣式 ===== */
.edit-form {
    padding: 10rpx 0;
}

.form-item {
    margin-bottom: 24rpx;
}

.form-label {
    font-size: 26rpx;
    color: #64748B;
    margin-bottom: 12rpx;
    display: block;
    font-weight: 500;
}

.custom-input {
    background: #F1F5F9;
    border-radius: 12rpx;
    padding: 16rpx 24rpx !important;
    font-size: 28rpx;
}

.picker-display {
    background: #F1F5F9;
    border-radius: 12rpx;
    padding: 20rpx 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 28rpx;
    color: #0F172A;
}

.freq-options {
    display: flex;
    gap: 24rpx;
}

.freq-chip {
    flex: 1;
    background: #F1F5F9;
    color: #64748B;
    padding: 16rpx;
    text-align: center;
    border-radius: 12rpx;
    font-size: 28rpx;
    font-weight: 500;
    border: 2rpx solid transparent;
}

.freq-chip.active {
    background: #EFF6FF;
    color: #3B82F6;
    border-color: #3B82F6;
}

.form-hint {
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 22rpx;
    color: #F59E0B;
    margin-top: 12rpx;
    background: #FFFBEB;
    padding: 12rpx;
    border-radius: 8rpx;
}

.delete-btn-wrap {
    margin-top: 32rpx;
    display: flex;
    justify-content: center;
}
